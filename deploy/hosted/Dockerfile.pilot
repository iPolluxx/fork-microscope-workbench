# Build only from scripts/build_pilot_context.py's isolated source allowlist.
FROM python:3.13.12-slim-bookworm
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY fork_microscope /app/fork_microscope
COPY mcp /app/mcp
RUN useradd --uid 10001 --create-home app
USER 10001
ENV PORT=8080 PYTHONPATH=/app:/app/mcp/src PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
CMD ["uvicorn", "pilot_cloud:create_cloud_public_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
